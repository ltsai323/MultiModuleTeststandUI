##### IV curve for multiple channel
SHELL := /bin/bash
BASE_DIR :=$(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))






initialize: ## initialize hardwares. Currently check RS232 connections
	@( \
		cd scripts ; \
		python3 initialize_rs232_devices.py -c ../data/mmts_configurations.yaml MMTS_hardwares/vitek/Resource MMTS_hardwares/keithley/Resource; \
		sh IVscan.initialize.sh \
		&& echo "[INITIZLIZED_STATE]" \
	) \
	|| (echo "[ERROR_STATE]"; exit 1)

run: ## run thermal cycling plan and IV curves. Since python script will read arguments from server. No need to pass any argument here.
	cd external_packages/mmts-mqtt-bridge ; uv run closed_loop_test.py -p "$(BASE_DIR)"
stop: ## stop whole thermal cycling
	sleep 5 ## waiting for 5 second for stopping jobs

destroy: ## remove all running jobs and disable board power
	source ./init_bash_vars.sh && cd scripts && sh IVscan.stop.sh && sleep 5




test:
	make -f $(MAKEFILE_LIST) all_IVscan moduleID1L="320XHT4CPM00019"


IN_ARGS =  

help:  ## Display this help
	@awk 'BEGIN {FS = ":.*##"; printf "Usage: make \033[32m<command>\033[0m $(IN_ARGS)\n\nCommands:\n\033[36m\033[0m\n"} /^[0-9a-zA-Z_-]+:.*?##/ { printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

.DEFAULT_GOAL := help
