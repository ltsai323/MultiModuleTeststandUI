		echo "[ExistedPackage] mmts-thermal-auto found"; \
	else \
		echo "[Install mmts-thermal-auto] initialize 'mmts-thermal-auto' from github "; \
		git clone https://github.com/Xingfu23/mmts-thermal-auto.git $(mmts_thermal_auto_path); \
	fi

task2b_install_uv_virtualenv: ## install uv
	which uv || (curl -LsSf https://astral.sh/uv/install.sh | sh)

task2c_uvenv_mmts_thermal_auto:
	cd $(mmts_thermal_auto_path)/almalinux_core/mmts-mqtt-bridge/ && uv sync

task2d_edit_config:
