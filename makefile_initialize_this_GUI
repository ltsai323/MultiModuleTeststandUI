task3b_create_mmts_configuration: ## create mmts_configuration
	$(MAKE) -f $(MAKEFILE_LIST) _create_file_or_update_file newFILE=data/mmts_configurations.yaml templateFILE=data/mmts_configurations.yaml.default
	@if [ ! -f "$(andrewGUI_default_path)/configuration.yaml" ]; then \
		ln -s "$$PWD/data/mmts_configurations.yaml" "$(andrewGUI_default_path)/configuration.yaml"; \
	fi
	@if [ ! -f "$(youyingSCRIPT_default_path)/configuration.yaml" ]; then \
		ln -s "$$PWD/data/mmts_configurations.yaml" "$(youyingSCRIPT_default_path)/configuration.yaml"; \
	fi






### flask related setup
flaska_open_firewall_port5001: ## open firewall port 5001 such you can access server http://127.0.0.1:5001 
	echo '[OpenPort5001] requesting permission for opening firewall port 5001'
	sh scripts/open_firewall.sh


### use python virtual environment to activate this app
flaskb_make_virtual_environment: ## create python virtual envuironment
	if [ -d ".venv" ]; then \
		echo "[FlaskVenvExisted] Skip creating flask virtual environment"; \
	else \
		python3 -m venv .venv ; \
		source .venv/bin/activate ; \
		pip3 install   flask   flask-socketio   requests   sphinx   paramiko   pyvisa   pyvisa-py   pyyaml   flask-wtf   myst-parser   flask-cors   pymeasure   psycopg psycopg2-binary ; \
		sudo yum install firewalld; \
	fi
	#sudo apt update
	#sudo apt install python3-psycopg python3-psycopg-c
	#sudo apt update && sudo apt install firewalld

flaskc_make_app_as_system_service: ## make this MultimoduleTeststandUI as a system service
	if [ -f "/etc/systemd/system/MMTS.service" ]; then \
		echo "[MMTSserviceExisted] Skip creating MMTS.service"; \
	else \
		chmod +x ./app.py ; \
		python3 data/MMTS.service.createscript.py; \
		sudo cp data/MMTS.service /etc/systemd/system/; \
		sudo systemctl daemon-reload; \
		sudo systemctl start MMTS.service; \
		sudo systemctl enable MMTS.service; \
	fi

